# =========================================================
# CONFIGURACIÓN DE CORREO PARA FEEDBACK (RESEND)
# =========================================================
# 1. Crea una cuenta gratuita en https://resend.com (3.000 emails/mes gratis)
# 2. Genera una API Key en el dashboard de Resend
# 3. Pega tu API Key y tu correo de destino aquí debajo:

RESEND_API_KEY=re_your_api_key_here
FEEDBACK_TO_EMAIL=tu-correo-personal@ejemplo.com

# NOTA: En modo desarrollo local, si no configuras RESEND_API_KEY, 
# el sistema simula el envío imprimiéndolo en la consola del servidor
# para que puedas probar el formulario de inmediato sin trabas.
